# API (apps/api)
PORT=3000
# Signs session tokens. Use a long random string, e.g.:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=change-me-to-a-long-random-string

# Web (apps/web) — the Vite dev server proxies /api to this URL
VITE_API_URL=http://localhost:3000

# EJ Dashboard API (apps/ej-api); also uses AUTH_SECRET above
EJ_API_PORT=3100
# SQLite file for users; defaults to apps/ej-api/data/ej-dashboard.db
# EJ_DB_PATH=
# Test admin created when the users table is empty (defaults live in apps/ej-api/src/seed.ts)
EJ_SEED_ADMIN_EMAIL=admin@ejdashboard.local
EJ_SEED_ADMIN_PASSWORD=Admin12345

# EJ Dashboard web (apps/ej-web) — the Vite dev server proxies /api to this URL
VITE_EJ_API_URL=http://localhost:3100
